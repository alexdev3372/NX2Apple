+"""Skyrim 1.1.404 (v393216), matching main and SDK only."""
+
+MAIN = '0c0cac3fcf0f0beb9dcf79cb68e30739'
+SDK = '2aef2cffb104ee7c9e212fd2f4c731e9'
+CUTS_REQUIRE = {MAIN: {'sdk': SDK}}
+CUTS = {
+    MAIN: [
+        # Change reservation arguments, not the initial commits (85 MiB and 4 MiB).
+        (0x59bb24, '0100b052', '0100a452', 'Default Heap: reserve 512 MiB instead of 2 GiB'),
+        (0x5c62e0, '0100a852', '0100a252', 'BSSmallBlockAllocator: reserve 256 MiB instead of 1 GiB'),
+        # Mode 7 sets w21=1 in the shared depth-clear path and mode 1 leaves it zero.
+        # The later raw D24S8 compute write cannot initialize Metal's separate stencil plane.
+        # NEG supplies the full stencil mask only for mode 7. The stencil value, later compute
+        # dispatch and UI clear are unchanged. Port of the stencil approach in nxnative#444.
+        (0xbf7d5c, 'e3031f2a', 'e303154b', 'Helgen: initialize stencil in mode 7 and preserve the mode-1 depth-only clear'),
+    ],
+}
