+enum { W = 16, H = 2, STRIDE = 32, ROW = W * 4, OFFSET = 65536, POOL = 131072 };
+static int pixel_bytes(id<MTLBuffer> output, const uint8_t *source) {
+    int bad = 0; for (int y = 0; y < H; y++) bad += memcmp((uint8_t *)output.contents + y * ROW, source + y * STRIDE, ROW) != 0;
+    CHECK(!memcmp((uint8_t *)output.contents + 32, (uint8_t *)output.contents + ROW, 32), "x=8,y=0 aliases x=0,y=1 at the short row advance");
+    return bad;
+}
+static id<MTLBuffer> capture_pixels(id<MTLTexture> texture) {
+    if (!texture) return nil;
+    size_t row = texture.width * mtl_pf_block_bytes(texture.pixelFormat), image = row * texture.height;
+    id<MTLBuffer> output = [g_dev newBufferWithLength:image options:MTLResourceStorageModeShared];
+    res_add(output); defer_obj_release(output);
+    enc_b_copy_texture_buffer(blit(), texture, 0, 0, MTLOriginMake(0, 0, 0), MTLSizeMake(texture.width, texture.height, 1), output, 0, row, image);
+    return output;
+}
+static int pixels(id<MTLTexture> texture, const uint8_t *source) {
+    if (!texture) return 1;
+    id<MTLBuffer> output = [g_dev newBufferWithLength:ROW * H options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+              sourceSize:MTLSizeMake(W, H, 1) toBuffer:output destinationOffset:0
+              destinationBytesPerRow:ROW destinationBytesPerImage:ROW * H];
+    [blit endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    CHECK(cb.status == MTLCommandBufferStatusCompleted && !cb.error, "GPU readback completes with validation");
+    return pixel_bytes(output, source);
+}
+static void gpu_variant(pool_t *pool, size_t off, int format, unsigned w, unsigned h, unsigned stride, unsigned flags) {
