+// Short LINEAR row advances are kept in the retail NVN descriptor independently of width.
+// Synthetic guarded backing makes every sampled byte defined, including the last row's tail.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
