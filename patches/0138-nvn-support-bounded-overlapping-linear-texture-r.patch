                         id<MTLTexture> dst, NSUInteger slice, NSUInteger level) { up_blit_add_at(src, off, row, image, size, dst, slice, level, MTLOriginMake(0, 0, 0)); }
 
+// NVN keeps the full width and an explicit short pitch independently (retail descriptor), so rows may overlap.
+// Only the Metal sampling copy expands its read/dirty span through the final row, bounded by the owning pool;
+// the NVN object's reported storage size and row advance are never changed. -1: that span has no backing.
+static int linear_sample_copy(const tex_t *t, tex_t *out) {
+    if (!(t->d.flags & (NVN_TEXTURE_FLAGS_LINEAR | NVN_TEXTURE_FLAGS_LINEAR_RENDER_TARGET)) ||
+        t->d.target != NVN_TEXTURE_TARGET_2D || t->d.levels > 1 || t->d.samples > 1 || !t->mem) return 0;
+    int bw, bh, bpb = nvn_fmt_bpb(t->d.format, &bw, &bh);
+    if (!bpb || bw != 1 || bh != 1) return 0;
+    uint64_t row = tex_linear_row(t), bytes = (uint64_t)MAX(t->d.width, 1u) * bpb, h = MAX(t->d.height, 1u);
+    if (row >= bytes) return 0;
+    if (!row || h - 1 > (UINT64_MAX - bytes) / row) return -1;
+    uint64_t n = MAX(t->L.size, (h - 1) * row + bytes);
+    if (!t->pool || t->pool->magic != MAGIC('P','O','O','L') || !t->pool->mem || t->off < 0 ||
+        (uintptr_t)t->mem < (uintptr_t)t->pool->mem || (uintptr_t)t->mem - (uintptr_t)t->pool->mem != (uint64_t)t->off ||
+        (uint64_t)t->off > t->pool->size || n > t->pool->size - (uint64_t)t->off) return -1;
+    *out = *t; out->L.size = n; return 1;
+}
