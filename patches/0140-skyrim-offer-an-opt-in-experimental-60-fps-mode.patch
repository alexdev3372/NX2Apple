diff --git a/dm/gfx/tests/skyrim_fps_fixture.inc b/dm/gfx/tests/skyrim_fps_fixture.inc
new file mode 100644
index 0000000..040eb5b
--- /dev/null
+++ b/dm/gfx/tests/skyrim_fps_fixture.inc
@@ -0,0 +1,97 @@
+// Production FPS writer, NVN pacing/readback and host Quit. Synthetic guest pages and ticks.
+void dm_skyrim_fps_begin(int enabled);
+int dm_skyrim_fps_60(void);
+void dm_host_teardown_for_shell(void);
+static module_t modules[2];
+enum { IMGSZ = 0x3400000, MAX_OFF = 0x3357fb0, MIN_OFF = 0x3357fc8 };
+static uint8_t *active_image;
+static unsigned parked, releases;
+void dm_cheats_exit(void) {}
+void dm_vsync_stop_all(void) {}
+void dm_audio_quiesce_for_shell(void) {}
+void dm_audio_stop_all(void) {}
+void dm_audio_suspend(int on) { (void)on; }
+void dm_threads_park_all(void) { parked++; }
+void dm_guest_memory_release(int unmap_as) {
+    assert(unmap_as && parked == releases + 1);
+    assert(!dm_skyrim_fps_60() && "Quit must clear FPS state before unmapping");
+    assert(!mprotect(active_image, IMGSZ, PROT_NONE));
+    releases++;
+}
+void dm_modules_teardown(void) { g_mod = NULL; g_nmod = 0; }
+void hlecount_flush(void) {}
+void dm_rec_finish(void) {}
+extern int test_movie, test_thermal;
+static int skyrim_case(void) {
+    static const struct { const char *choice; int fault; } launches[] = {
+        {"30", 0}, {"60", 0}, {"30", 0}, {"60", 0}, {NULL, 0}, {"60fps", 0},
+        {"60", 1}, {"60", 2}, {"60", 3}, {"60", 4}, {"60", 5}, {"60", 6}, {"60", 7},
+    };
+    enum { n = sizeof launches / sizeof *launches };
+    uint8_t *images[n];
+    setenv("DM_FPS_TARGET", "0", 1); setenv("DM_RT", "0", 1); setenv("DM_PRESENT_SNAP", "0", 1);
+    unsetenv("DM_THERMAL_CAP");
+    g_dm_present_link = 1; g_link = (CAMetalDisplayLink *)[NSObject new]; g_link_mode = 1;
+    for (size_t i = 0; i < n; i++) {
+        active_image = images[i] = mmap(NULL, IMGSZ, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        assert(active_image != MAP_FAILED);
+        for (size_t j = 0; j < i; j++) assert(images[j] != active_image);
+        memset(modules, 0, sizeof modules); g_mod = modules; g_nmod = 2;
+        strcpy(modules[0].name, "main"); strcpy(modules[0].build_id, "0c0cac3fcf0f0beb9dcf79cb68e30739");
+        strcpy(modules[1].name, "sdk"); strcpy(modules[1].build_id, "2aef2cffb104ee7c9e212fd2f4c731e9");
+        modules[0].base = modules[1].base = active_image;
+        modules[0].loaded = modules[1].loaded = 1;
+        modules[0].size = IMGSZ; modules[0].text_end = 0x1265968; modules[0].data_off = 0x1a04000;
+        *(uint32_t *)(active_image + 0xbe19dc) = 0xf945ed08;
+        *(uint32_t *)(active_image + 0xbe19e8) = 0xbd400902;
+        *(uint32_t *)(active_image + 0xbe19f8) = 0xf945f129;
+        *(uint32_t *)(active_image + 0xbe1a04) = 0xbd400920;
+        int fault = launches[i].fault;
+        if (fault == 2) modules[0].build_id[31] = '8';
+        if (fault == 3) modules[1].build_id[31] = '8';
+        if (fault == 4) *(uint32_t *)(active_image + 0xbe1a04) = 0;
+        if (fault == 5) modules[0].size = MIN_OFF;
+        if (fault == 6) modules[0].data_off = MAX_OFF + 4;
+        if (fault == 7) g_nmod = 1;
+        if (launches[i].choice) setenv("DM_SKYRIM_FPS", launches[i].choice, 1); else unsetenv("DM_SKYRIM_FPS");
+        dm_skyrim_fps_begin(fault != 1);
+        int fast = i == 1 || i == 3;
+        assert(dm_skyrim_fps_60() == fast && "validate this launch only");
+        setenv("DM_SKYRIM_FPS", fast ? "30" : "60", 1);  // not a live toggle
+        float *max = (float *)(active_image + MAX_OFF), *min = (float *)(active_image + MIN_OFF);
+        dm_fps_lock_tick(); assert(*max == 0 && *min == 0);
+        *max = 33; *min = 28;
+        dm_fps_lock_tick(); assert(*max == 33 && *min == 28);
+        for (int reload = 0; reload < 2; reload++) {
+            *max = 33; *min = 30;
+            dm_fps_lock_tick(); assert(*max == (fast ? 16.5f : 33) && *min == (fast ? 15 : 30));
+        }
+        win_t win = {.interval = 2};
+        acquire_ticks(60, 0, 2, fast ? 1 : 2, "Skyrim acquire after same-process launch");
+        assert(h_nvnWindowGetPresentInterval((NVNwindow *)&win) == (fast ? 1 : 2));
+        assert(present_period(&win) == (fast ? 1000000000ull / 60 : 2000000000ull / 60));
+        if (fast) assert(nvn_game_fps() == 60);
+        if (i == 3) {
+            test_movie = 1;
+            acquire_ticks(60, 0, 2, 2, "movie fallback");
+            assert(nvn_game_fps() == 30 && h_nvnWindowGetPresentInterval((NVNwindow *)&win) == 2);
+            test_movie = 0;
+            test_thermal = 2; test_now += 1000000000ull;
+            acquire_ticks(60, 0, 2, 2, "serious-thermal fallback");
+            test_thermal = 0; test_now += 1000000000ull;
+            assert(nvn_game_fps() == 30);
+            test_now += 31000000000ull;
+            acquire_ticks(60, 0, 2, 1, "back to 60 after thermal recovery");
+        }
+        // The fake CAMetalDisplayLink must not enter the real Metal shutdown.
+        g_link = nil;
+        dm_host_teardown_for_shell();
+        dm_fps_lock_tick();  // late call; old guest mapping is inaccessible, no segment restore performed
+        assert(!g_mod && !g_nmod && releases == i + 1);
+        dm_gfx_suspend(0);
+        g_dm_present_link = 1; g_link = (CAMetalDisplayLink *)[NSObject new]; g_link_mode = 1;
+    }
+    for (size_t i = 0; i < n; i++) assert(!munmap(images[i], IMGSZ));
+    printf("Skyrim focused: %d launches, %u host Quit calls, PID %d, %d failed\n", n, releases, getpid(), failed);
+    return failed != 0;
+}
