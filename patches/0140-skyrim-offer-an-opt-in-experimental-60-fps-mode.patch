@@ -27,13 +27,15 @@ static int test_clock_gettime(clockid_t clock, struct timespec *t) {
 #undef DM_GAME_FPS_MAX
 static int test_fps_max = 120;
 #define DM_GAME_FPS_MAX test_fps_max
+#define dm_fps_lock_engine test_engine_stub
