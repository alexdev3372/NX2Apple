          f'#define DM_GAME_ENV {q(g.get("game_env", ""))}',   # KEY=VALUE pairs getenv answers (hle_os.c; Absolum: .NET's DOTNET_GCRegionRange)
diff --git a/dm/games/settings.py b/dm/games/settings.py
index 7b7e253..e00d533 100644
--- a/dm/games/settings.py
+++ b/dm/games/settings.py
@@ -56,6 +56,20 @@ def fixups_keys(path):   # '# KEY<TAB>value' header rows of a rewriter table, as
     return {m[1]: m[2].strip() for m in re.finditer(r'^# (\w+)\t(.*)$', path.read_text(encoding='utf-8'), re.M)}
 
 
+def skyrim_fps_supported(patched, main_keys):
+    # Match the runtime guard in hle_fpslock.c. Never trust a fixups feature flag.
+    if main_keys.get('BUILD_ID') != '0c0cac3fcf0f0beb9dcf79cb68e30739': return False
+    if fixups_keys(patched / 'sdk.fixups.tsv').get('BUILD_ID') != '2aef2cffb104ee7c9e212fd2f4c731e9': return False
+    try:
+        with (patched / 'main.patched.bin').open('rb') as f:
+            for off, word in ((0xbe19dc, 0xf945ed08), (0xbe19e8, 0xbd400902), (0xbe19f8, 0xf945f129), (0xbe1a04, 0xbd400920)):
+                f.seek(off)
+                if f.read(4) != word.to_bytes(4, 'little'): return False
+    except OSError:
+        return False
+    return True
+
+
 UNKNOWN_LANGUAGES = 'This game\'s files do not list its languages, so some of these may not be in the game. It may then show another one.'
 
 
@@ -65,6 +79,10 @@ def build(gid, patched, control):
     g = game.load(gid)
     macros = dict(re.findall(r'^#define (DM_GAME_\w+) (.*)$', game.header_one(g), re.M))   # the host's own defaults, as it is compiled for this game
     keys = fixups_keys(Path(patched) / 'main.fixups.tsv')
+    keys.pop('SKYRIM_FPS', None)
+    skyrim_fps = platform == 'mac' or os.environ.get('SETTINGS_SKYRIM_FPS_PROTOTYPE') == '1'
+    if skyrim_fps and g.get('skyrim_fps_experiment', 'off') == 'on' and skyrim_fps_supported(Path(patched), keys):
+        keys['SKYRIM_FPS'] = '1'
     have = nacp.languages(control)
     langs = [(c, n) for c, n in nacp.LANGUAGES if not have or c in have]   # no list (a dump or a NUP has no control data, none of its packages may): any language may be the game's, as DM_LANG and the NSP script's check take it
 
