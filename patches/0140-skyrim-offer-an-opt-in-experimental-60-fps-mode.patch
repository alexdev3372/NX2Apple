@@ -0,0 +1,56 @@
+"""Use synthetic rewritten inputs to exercise the actual launcher settings generator."""
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/games'))
+import settings
+
+TITLE = '01000A10041EA000'
+MAIN = '0c0cac3fcf0f0beb9dcf79cb68e30739'
+SDK = '2aef2cffb104ee7c9e212fd2f4c731e9'
+KEY = 'DM_SKYRIM_FPS'
+
+
+class SkyrimSettings(unittest.TestCase):
+    def test_exact_build_and_platform_gate(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {'GFXAPI': 'nvn', 'SETTINGS_PLATFORM': 'mac', 'SETTINGS_SKYRIM_FPS_PROTOTYPE': '0'}):
+            p = Path(tmp)
+
+            def rows(title=TITLE, **env):
+                with patch.dict(os.environ, env):
+                    return {r['env']: r for r in settings.build(title, p, p / 'missing.nacp')['settings']}
+
+            def ids(main=MAIN, sdk=SDK):
+                (p / 'main.fixups.tsv').write_text(f'# BUILD_ID\t{main}\n# SKYRIM_FPS\t1\n')
+                (p / 'sdk.fixups.tsv').write_text(f'# BUILD_ID\t{sdk}\n')
+
+            self.assertNotIn(KEY, rows())
+            ids()
+            self.assertNotIn(KEY, rows())
+            img = p / 'main.patched.bin'
+            with img.open('wb') as f:
+                for off, word in ((0xbe19dc, 0xf945ed08), (0xbe19e8, 0xbd400902), (0xbe19f8, 0xf945f129), (0xbe1a04, 0xbd400920)):
+                    f.seek(off)
+                    f.write(struct.pack('<I', word))
+            mac = rows()[KEY]
+            self.assertEqual(mac['default'], '30')
+            self.assertEqual([v[0] for v in mac['options']], ['30', '60'])
+            self.assertIn('experimental', mac['options'][1][1])
+            self.assertNotIn(KEY, rows(SETTINGS_PLATFORM='ios'))
+            self.assertEqual(rows(SETTINGS_PLATFORM='ios', SETTINGS_SKYRIM_FPS_PROTOTYPE='1')[KEY], mac)
+            self.assertNotIn(KEY, rows(GFXAPI='vulkan'))
+            self.assertNotIn(KEY, rows(title='010015100B514000'))
+            ids(main='1' + MAIN[1:]); self.assertNotIn(KEY, rows())
+            ids(sdk='1' + SDK[1:]); self.assertNotIn(KEY, rows())
+            (p / 'sdk.fixups.tsv').unlink(); self.assertNotIn(KEY, rows())
+            ids()
+            with img.open('r+b') as f:
+                f.seek(0xbe19dc)
+                f.write(bytes(4))
+            self.assertNotIn(KEY, rows())
