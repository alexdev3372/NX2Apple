+# Skyrim 1.1.404. Only the registered main and SDK are covered by the memory and lighting fixes.
+title_id	01000A10041EA000
+program_id	01000A10041EA000
+name	The Elder Scrolls V: Skyrim
+ipa	TheElderScrollsVSkyrim.ipa
+app_category	public.app-category.games
+build	v393216	1.1.404.0	main=0c0cac3fcf0f0beb9dcf79cb68e30739	sdk=2aef2cffb104ee7c9e212fd2f4c731e9
+package	v393216
+modules	main sdk
+romfs_marker	Data/Skyrim - Voices_en0.bsa
+zip_store	.bik:.bsa:.esm:.metallib
+
+# Give the remaining regions room without changing the game stack or app pool.
+# patches.py reduces two guest heap reservations, not their initial commits.
+mem_reserve	0x160000000
+mem_alias	0x138000000
+mem_stack	0x10000000
+app_pool	0xCD500000
+sys_resource	0x800000
+
+# Generate all shader tables from the user's verified dump in the build workspace.
+shader_versions	v393216
+split_dump_tables	on
+shader_groups	/Data/=data /BatchFiles/=batchfiles
+shader_note	The Elder Scrolls V: Skyrim shaders
+depth_mode	zero
+skyrim_fps_experiment	on
