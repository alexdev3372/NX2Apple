diff --git a/dm/gfx/tools/shader_split.py b/dm/gfx/tools/shader_split.py
index ea390b0..50d34db 100644
--- a/dm/gfx/tools/shader_split.py
+++ b/dm/gfx/tools/shader_split.py
@@ -380,6 +380,24 @@ def glslc_stage(ctl, code):
     headerless_cs = code[:4] not in (CS_MAGIC, GFX_MAGIC) and len(ctl) >= 0x754 and all(struct.unpack_from('<3I', ctl, 0x748))
     return 'cs' if code[:4] == CS_MAGIC or headerless_cs else sph_stage(code) if code[:4] == GFX_MAGIC and len(code) >= 0x34 else None
 
+def nvn_binary_shaders(d, label):
+    """NVN binaries with an inline control section: four u32 {control offset, control length, code offset, code length}, relative to the descriptor. Skyrim's stored FXP and main
+    use these without whole GLSLC headers. Recognize only bounded, non-overlapping ranges that pass the same stage and control/code checks; executable literals are not records."""
+    out, end = [], 0
+    view = memoryview(d)   # reject invalid candidates without copying their potentially large control/code sections
+    for m in re.finditer(CTL_MAGIC, d):
+        c = m.start(); h = c - 16
+        if h < end: continue
+        coff, nctl, koff, ncode = struct.unpack_from('<4I', d, h)
+        if coff != 16 or nctl < 0x760 or c + nctl > len(d) or koff < coff + nctl or ncode < 8 or h + koff + ncode > len(d): continue
+        ctl, code = view[c:c + nctl], view[h + koff:h + koff + ncode]
+        st = glslc_stage(ctl, code)
+        if st and (st == 'cs' or len(code) >= 0x80) and not check(label, st, ctl, code):
+            out.append((f'{label}#NVNBIN@{h:#x}', st, bytes(ctl), bytes(code)))
+            end = h + koff + ncode   # skip descriptors inside accepted binaries: retained sections add up to at most len(d)
+    return out
+
+
 def glslc_layout(d, h):
     """The header of the GLSLC output at h → (the whole output's length, section count, first section header, distance between section headers), all relative to the output.
     An NVN2 output (Pokemon Pokopia's G2S containers and main: GPU code version 0xc9 at +0x30, +0x44 zero) has the same section header fields as an NVN output, further along"""
@@ -3296,6 +3314,10 @@ def scan_blob(d, label, out, depth=0, left=None):
     if MGFX in d: out.extend(mgfx_shaders(d, label))
     if NEEDLE in d: out.extend(needle_shaders(d, label))
     if SUMO_NX in d or NVNSH in d: out.extend(sumo_shaders(d, label))
+    binaries = nvn_binary_shaders(d, label)
+    # Adding inline binaries suppresses the callers' GLSLC fallback. Read both, whole outputs first to preserve their source label in uniq_keys.
+    if binaries and b'\x91\x68\x86\x19' in d: out.extend(glslc_shaders(d, label, need=False))
+    out.extend(binaries)
 
 def merge_keys(results):
     """The shaders of every scanned file, one row per key: (where, stage, control, code), the pairs, and the rows per source group. A key found more than once keeps its first copy,
@@ -3333,7 +3355,7 @@ def pixel_input_cover(shaders):
         k = min(ins, key=lambda k: (-len(ins[k] & left), k)); cover.append(k); left -= ins[k]
     return cover
 
-SINGLE_STAGE = ('#GLSLC@', '#VIPER', '#CIVBSF@', '#UE', '#MTSPK@', '#MGFX@', '#NLG', '#PGSO', '#RAW@', '#TFXO@', '#NEEDLE@', '#SNOWDROP@', '#PHYRE@', '#SUMO@', '#NVNSH@', '#D3@', '#SHAD@')   # sources whose every shader is a program of one stage: GLSLC outputs, Unreal's shader records, MT Framework's shader package (BNSH variations, Unity programs, MSHD and SDF pair theirs);
