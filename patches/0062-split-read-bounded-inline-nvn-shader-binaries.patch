diff --git a/dm/tools/tests/test_split_nvn_binary.py b/dm/tools/tests/test_split_nvn_binary.py
new file mode 100644
index 0000000..fa714f5
--- /dev/null
+++ b/dm/tools/tests/test_split_nvn_binary.py
@@ -0,0 +1,179 @@
+"""Descriptor-relative NVN control/code records; synthetic fixtures, no game files."""
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import unittest
+import zipfile
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/gfx/tools'))
+_had = os.environ.get('DM_GAME'); os.environ['DM_GAME'] = '010015100B514000'
+import shader_split as ss
+if _had is None: del os.environ['DM_GAME']
+else: os.environ['DM_GAME'] = _had
+
+
+def binary(stage='vs', control_length=0x880, gap=0):
+    control = bytearray(control_length)
+    control[:4] = ss.CTL_MAGIC
+    struct.pack_into('<I', control, 0x20, control_length)
+    code = bytearray(0x100)
+    code[:4] = ss.CS_MAGIC if stage == 'cs' else ss.GFX_MAGIC
+    if stage != 'cs': struct.pack_into('<I', code, 0x30, 0x61 | {'vs': 1, 'ps': 5}[stage] << 10)
+    if stage == 'ps': struct.pack_into('<I', code, 0x48, 1)   # pixel input location 0
+    struct.pack_into('<I', control, 0x704, len(code))
+    descriptor = struct.pack('<4I', 16, len(control), 16 + len(control) + gap, len(code))
+    return descriptor + control + bytes(gap) + code
+
+
+def glslc_output(stage='ps', inline_descriptor=False):
+    record = binary(stage)
+    header = bytearray(0x100)
+    header[:4] = bytes.fromhex('91688619')
+    struct.pack_into('<I', header, 0x44, len(header) + len(record) - 16)
+    if inline_descriptor: header[-16:] = record[:16]
+    return header + record[16:]
+
+
+class NvnBinary(unittest.TestCase):
+    def test_descriptor_is_scanned_without_a_container_magic(self):
+        out = []
+        ss.scan_blob(binary(), 'fixture', out)
+        self.assertEqual(len(out), 1)
+        self.assertEqual(out[0][1], 'vs')
+        self.assertIsNone(ss.check(*out[0]))
+
+    def test_stored_binary_passes_the_loose_file_prefilter(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'stored.bin'
+            path.write_bytes(b'stored container' + binary())
+            _, keys, _, _ = ss.scan_file_in((str(path), 'stored.bin'))
+        self.assertEqual(len(keys), 1)
+
+    def test_mixed_formats_survive_blob_loose_file_and_zip_scans(self):
+        data = binary('vs') + glslc_output('ps')
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'mixed.bin'
+            path.write_bytes(data)
+            archive = Path(tmp) / 'mixed.zip'
+            with zipfile.ZipFile(archive, 'w', compression=zipfile.ZIP_DEFLATED) as z:
+                z.writestr('mixed.bin', data)
+            for source in ('blob', 'loose', 'zip'):
+                with self.subTest(source=source):
+                    if source == 'blob':
+                        found = []
+                        ss.scan_blob(data, 'fixture', found)
+                        keys = ss.uniq_keys(found)
+                    elif source == 'loose':
+                        _, keys, _, _ = ss.scan_file_in((str(path), 'mixed.bin'))
+                    else:
+                        _, keys, _, _ = ss.scan_file_in((str(archive), 'mixed.zip', (ss.ZIP, ('mixed.bin',))))
+                    self.assertEqual({v[1] for v in keys.values()}, {'vs', 'ps'})
+                    self.assertEqual(len(keys), 2)
+                    for shader in keys.values(): self.assertIsNone(ss.check(*shader))
+
+    def test_matching_outputs_deduplicate_with_the_glslc_source_label(self):
+        record = binary('vs')
+        found = []
+        ss.scan_blob(record + glslc_output('vs', inline_descriptor=True), 'fixture', found)
+        self.assertGreater(len(found), 1)
+        keys = ss.uniq_keys(found)
+        self.assertEqual(len(keys), 1)
+        shader, = keys.values()
+        self.assertEqual(shader[0], f'fixture#GLSLC@{len(record):#x}')
+        self.assertEqual(shader[1:], ('vs', record[16:16 + 0x880], record[16 + 0x880:]))
+
+    def test_single_stage_vertex_gets_pixel_input_coverage(self):
+        found = []
+        ss.scan_blob(binary('vs') + binary('ps'), 'fixture', found)
+        keys = ss.uniq_keys(found)
+        vertex = next(k for k, v in keys.items() if v[1] == 'vs')
+        pixel = next(k for k, v in keys.items() if v[1] == 'ps')
+        pairs, cover = ss.separable_pairs(keys)
+        self.assertEqual(pairs, {(vertex, pixel)})
+        self.assertEqual(cover, [pixel])
+
+    def test_unaligned_control_and_shorter_control_length(self):
+        found = []
+        ss.scan_blob(b'odd' + binary(control_length=0x7d1, gap=7), 'fixture', found)
+        self.assertEqual(len(found), 1)
+        self.assertEqual(len(found[0][2]), 0x7d1)
+        self.assertIsNone(ss.check(*found[0]))
+
+    def test_graphics_and_compute_stages(self):
+        found = []
+        ss.scan_blob(binary('vs') + binary('ps') + binary('cs'), 'fixture', found)
+        self.assertEqual([s[1] for s in found], ['vs', 'ps', 'cs'])
+
+    def test_overlapping_records_retain_at_most_the_input_size(self):
+        code = binary()[16 + 0x880:]
+        common = 64 * 0x800
+        data = bytearray(common + len(code))
+        data[common:] = code
+        for h in range(0, common, 0x800):
+            c = h + 16
+            struct.pack_into('<4I', data, h, 16, common - c, common - h, len(code))
+            data[c:c + 4] = ss.CTL_MAGIC
+            struct.pack_into('<I', data, c + 0x20, 0x7d1)
+            struct.pack_into('<I', data, c + 0x704, len(code))
+        found = ss.nvn_binary_shaders(data, 'overlap')
+        self.assertTrue(found)
+        self.assertLessEqual(sum(len(ctl) + len(code) for _, _, ctl, code in found), len(data))
+        self.assertEqual(len(found), 1)
+        self.assertIsNone(ss.check(*found[0]))
+
+    def test_invalid_candidates_are_checked_without_section_copies(self):
+        class CopyTracked(bytearray):
+            copied = 0
+
+            def __getitem__(self, key):
+                value = super().__getitem__(key)
+                if isinstance(key, slice): self.copied += len(value)
+                return value
+
+        for offset, value in ((16 + 0x20, 0x880), (16 + 0x704, 0xff), (16 + 0x7d1 + 0x30, 0)):
+            with self.subTest(offset=offset):
+                data = CopyTracked(binary(control_length=0x7d1))
+                struct.pack_into('<I', data, offset, value)
+                self.assertEqual(ss.nvn_binary_shaders(data, 'invalid'), [])
+                self.assertEqual(data.copied, 0)
+
+    def test_headerless_compute_uses_control_thread_group(self):
+        d = bytearray(binary('cs'))
+        struct.pack_into('<3I', d, 16 + 0x748, 1, 1, 1)
+        d[16 + 0x880:16 + 0x884] = bytes(4)
+        found = ss.nvn_binary_shaders(d, 'fixture')
+        self.assertEqual([s[1] for s in found], ['cs'])
+
+    def test_invalid_descriptor_ranges_are_not_shaders(self):
+        for field, value in ((0, 0), (1, 0x75f), (1, 0xffffffff), (2, 16), (2, 0xffffffff), (3, 0xffffffff)):
+            with self.subTest(field=field, value=value):
+                d = bytearray(binary())
+                struct.pack_into('<I', d, 4 * field, value)
+                self.assertEqual(ss.nvn_binary_shaders(d, 'fixture'), [])
+
+    def test_truncated_ranges_are_not_shaders(self):
+        d = binary()
+        for length in (0, 15, 16, 35, 16 + 0x880, len(d) - 1):
+            with self.subTest(length=length):
+                self.assertEqual(ss.nvn_binary_shaders(d[:length], 'fixture'), [])
+
+    def test_control_code_length_must_agree(self):
+        d = bytearray(binary())
+        struct.pack_into('<I', d, 16 + 0x704, 0xff)
+        self.assertEqual(ss.nvn_binary_shaders(d, 'fixture'), [])
+
+    def test_control_literal_without_a_descriptor_is_ignored(self):
+        self.assertEqual(ss.nvn_binary_shaders(binary()[16:], 'fixture'), [])
+
+    def test_short_graphics_header_is_not_a_complete_shader(self):
+        d = bytearray(binary()[:16 + 0x880 + 0x34])
+        struct.pack_into('<I', d, 12, 0x34)
+        struct.pack_into('<I', d, 16 + 0x704, 0x34)
+        self.assertEqual(ss.nvn_binary_shaders(d, 'fixture'), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
