+        id<MTL4ComputeCommandEncoder> e = dispatch_enc(); enc_c_pso(e, ps);
+        enc_c_args(e, src, 0); enc_c_args(e, pg, 1); enc_c_args(e, qb.gpuAddress + qo, 2); enc_c_args(e, eb ? eb.gpuAddress : pg, 3);
+        enc_c_dispatch(e, MTLSizeMake((nx + 31) / 32, serial_rows ? 1 : g->rows, n), MTLSizeMake(32, 1, 1));
+    }
+    if (short_row) {
+        // Short-pitch LINEAR storage is authoritative; the private texture is only its coherent sampling copy.
+        // A rectangle's stored bytes may also name texels outside that rectangle. Re-read every logical row
+        // from the GPU backing after the store, before any later read (including gsb_held's same-buffer path).
+        // Never snapshot the in-flight backing on the CPU or put this in the earlier-running upload batch.
+        id<MTLTexture> mt = tex_made(t);
+        if (gsb_host_ok(t, mt)) {
+            id<MTLBuffer> sb = (__bridge id<MTLBuffer>)pb; size_t so = po, row = tex_linear_row(t);
+            size_t bytes = (size_t)mt.width * g->bpb, rows = mt.height;
