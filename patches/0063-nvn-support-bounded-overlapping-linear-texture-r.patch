+// Timestamp reports retire a caller's pending counter word for both report types.
+static void check_timestamp_reports(void) {
+    for (int i = 0; i < 2; i++) {
+        uint64_t data[2] = {3, UINT64_MAX};
+        post_op *op = calloc(1, sizeof *op);
+        op->type = i ? 0x10 : 0;
+        op->addr = (uint64_t)(uintptr_t)data;
+        post_rec record = {.fence = (uint64_t)i + 1, .n = 1, .ops = op};
+        pthread_mutex_lock(&g_post_mu);   // post_run consumes a claimed record under this lock
+        post_run(&record, 10000, 20000);
+        CHECK("completed timestamp report clears the pending counter word", data[0] == 0);
+        CHECK("completed timestamp report retains a nonzero timestamp", data[1] != 0 && data[1] != UINT64_MAX);
+    }
+}
+
