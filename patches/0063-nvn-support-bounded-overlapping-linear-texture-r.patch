+    tex_t sampled; int short_row = linear_sample_copy(t, &sampled);
+    if (short_row < 0) { RED_ONCE(153, "short-pitch linear texture samples outside its memory pool"); return nil; }
+    if (short_row) t = &sampled;
     MTLTextureDescriptor *d = tex_desc(t, 1);
     if (!d) return nil;
     d.usage |= keep & (MTLTextureUsageRenderTarget | MTLTextureUsagePixelFormatView);
