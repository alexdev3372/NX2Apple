+    if (t->d.flags & (NVN_TEXTURE_FLAGS_LINEAR | NVN_TEXTURE_FLAGS_LINEAR_RENDER_TARGET)) {   // rows of its stride, one 2D level (as pkg_upload_ reads them)
         if (t->d.target != NVN_TEXTURE_TARGET_2D || level || slice || n != 1 || bw != 1 || bh != 1 || !t->d.height) return -1;
+        tex_t sampled; int short_row = linear_sample_copy(t, &sampled);
+        if (short_row < 0) return -1;
+        if (short_row) t = &sampled;
         size_t srow = tex_linear_row(t);
-        if (g->xb1 > srow || (size_t)by1 * srow > t->L.size || srow > UINT32_MAX) return -1;
+        if (!srow || srow > UINT32_MAX || g->xb1 > t->L.size || by1 - 1 > (t->L.size - g->xb1) / srow) return -1;
         g->lin = (uint32_t)srow; return 0;
     }
     uint32_t row, rows, slices, gbpb; unsigned th, td;
@@ -5666,6 +5699,9 @@ static int gsb_geom(const tex_t *t, unsigned level, unsigned slice, unsigned n,
 static void gsb_missed(const tex_t *t, unsigned level, const char *why);
 // The swizzle into the storage: src the GPU address of the linear region's first image at column xb0 & ~15 (rows pitch apart, images img apart)
 static void gsb_swz(const tex_t *t, const gsb_geo *g, unsigned n, uint64_t src, size_t pitch, size_t img) {
+    tex_t sampled; int short_row = linear_sample_copy(t, &sampled);
+    if (short_row < 0) { RED_ONCE(153, "short-pitch linear texture samples outside its memory pool"); return; }
+    if (short_row) t = &sampled;   // the store's mapping and GPU edge buffer cover the same bounded span cached at upload
     static id<MTLComputePipelineState> ps; static int failed;
     if (failed) return;
     if (!ps) {
@@ -5675,6 +5711,7 @@ static void gsb_swz(const tex_t *t, const gsb_geo *g, unsigned n, uint64_t src,
     }
     void *pb; uint64_t po, pg, pt = 0, va = (uint64_t)(uintptr_t)t->mem, lo = 0, hi = 0;
