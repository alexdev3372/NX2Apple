+    CHECK(!memcmp(t.mem, want, span), "GPU variant preserves the complete authoritative sampled span");
+    CHECK(output && !memcmp(output.contents, expected, row * h), "GPU variant samples every pitched byte in Metal's packed-channel order");
+    CHECK(t.L.size == (uint64_t)stride * h && t.d.stride == stride && t.d.width == w, "GPU variant preserves public storage size, pitch and width");
